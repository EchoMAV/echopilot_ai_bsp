# Firmware suitable for flashing EchoPilot AI to experience Simulation-on-Hardware

include ../EchoPilotAI/hwdef.dat
include ../include/SimOnHW.inc

# short board name override (23 chars)
define CHIBIOS_SHORT_BOARD_NAME "EchoPilotAISimOnHW"

# bootloader embedding / bootloader flashing not available
define AP_BOOTLOADER_FLASHING_ENABLED 0

AUTOBUILD_TARGETS Plane
